# Carver on Apache shared hosting (upload the contents of dist/ as is, including this file).
AddType application/wasm .wasm
AddType text/javascript .mjs .js
AddType application/manifest+json .webmanifest

<IfModule mod_headers.c>
  # hashed build files never change -> cache forever; the page and the service worker -> always revalidate
  <FilesMatch "\.(js|mjs|wasm|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(index\.html|sw\.js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/wasm application/json
</IfModule>
